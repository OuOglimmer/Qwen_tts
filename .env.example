# Optional overrides. Relative paths are resolved from the project root.
# Leave QWEN_TTS_DATA_DIR unset to keep an existing repository-local data/app.db.
# New installs may use %LOCALAPPDATA%/QwenTTSVoiceoverStudio automatically.
# QWEN_TTS_DATA_DIR=
QWEN_TTS_MODEL_ROOT=models
QWEN_TTS_GENERATION_MODEL_PATH=models/voice_design_1.7b
QWEN_TTS_CLONE_MODEL_PATH=models/voice_clone_1.7b

# Optional Hugging Face authentication for gated/private model access.
# HF_TOKEN=

# Optional: restrict CORS to specific frontend origins. By default all origins are
# allowed so the app works over the LAN (http://<LAN-IP>:3000). Set this to lock it down.
# QWEN_TTS_CORS_ORIGINS=http://localhost:3000,http://192.168.89.200:3000

# Optional: allow the backend to write to paths chosen by the caller on THIS machine
# (folder picker, "open folder", export-to-directory). Leave this unset when the
# service is shared: those endpoints answer 403 and deliverables reach the caller's
# own machine through the browser folder picker or the streamed ZIP instead.
# Set to 1 only for single-user, same-machine use (the Gradio studio needs it).
# Accepts 1 / true / yes / on.
# QWEN_TTS_ALLOW_HOST_FS=1
